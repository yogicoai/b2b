# ═══════════════════════════════════════════════════════════════
# yogiboB2b 환경변수 템플릿
#
# 로컬:  이 파일을 .env.local 로 복사하고 값을 채운다
# 배포:  Vercel → Project Settings → Environment Variables 에 그대로 붙여넣는다
#
# 실제 값이 든 .env.local 은 저장소에 올라가지 않는다 (.gitignore)
# ═══════════════════════════════════════════════════════════════

# ── DB ───────────────────────────────────────────────────────
# ⚠️ 경로에 DB명(/yogiboB2b)까지 반드시 포함할 것.
#    scripts/ 의 유지보수 스크립트 60여 개가 dbName 옵션 없이 connect 하는데,
#    경로가 비면 전부 기본 DB(test)에 붙는다. 해외 바이어 CRM 과 같은 클러스터라
#    특히 조심해야 한다.
MONGODB_URI=mongodb+srv://<user>:<pass>@<host>/yogiboB2b?appName=<app>
MONGODB_DB=yogiboB2b

# ── 로그인 ───────────────────────────────────────────────────
JWT_SECRET=<32자 이상 임의 문자열>
ADMIN_ID=admin
ADMIN_PASSWORD=<초기 비밀번호 — 첫 로그인 후 앱에서 변경>
# 마스터 계정 (쉼표 구분). 이 아이디들은 등록된 발송 계정을 모두 본다
ADMIN_IDS=admin

# ── AI (리드 규모 검증 · 메일 분석 · 답장 초안) ────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── 네이버 검색 API (업체 발굴) ───────────────────────────────
# developers.naver.com — '검색' API 신청. 무료, 일 25,000건
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 메일 발송 (이카운트 SMTP) ─────────────────────────────────
SMTP_HOST=wsmtp.ecount.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# 1 = 실제 발송 안 함 (로그만) · 0 = 실전 발송
# 배포 직후에는 1 로 두고 화면을 확인한 뒤 0 으로 바꾸는 것을 권한다
MAIL_DRY_RUN=1

# ── 정보통신망법 제50조 (광고성 메일 필수 항목) ────────────────
# 본문 하단 발신자 정보로 그대로 나간다. 비우면 '발신자 정보 누락'이 된다
COMPANY_NAME=
COMPANY_ADDR=
COMPANY_TEL=

# 수신거부 링크 서명 키.
# ⚠️ 한 번 정하면 바꾸지 말 것 — 바꾸면 이미 나간 메일의 수신거부 링크가 전부 무효가 된다
UNSUB_SECRET=<긴 임의 문자열>

# 수신거부 링크가 가리킬 주소.
# ⚠️ localhost 면 실제 발송이 막힌다. 받는 사람 브라우저에서 안 열리는 링크는
#    수신거부 수단을 제공하지 않은 것과 같다 (제50조 제4항)
APP_BASE_URL=https://<배포 주소>

# ── 크론 (예약 발송 처리 · 매일 아침 브리핑) ───────────────────
# 이게 없으면 URL 아는 사람 누구나 발송을 돌릴 수 있다
CRON_SECRET=<임의 문자열>

# ── 선택 ─────────────────────────────────────────────────────
# 자사·계열 메일 도메인 (쉼표 구분). 사내 메일이 거래처 폴더로 잡히는 것을 막는다.
# 코드에 yogibo.inc·yogico.kr·yogibo.co.kr 은 이미 들어 있다
# OWN_MAIL_DOMAINS=
